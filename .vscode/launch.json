{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Smart Campus Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-hostname",
        "localhost",
        "--web-port",
        "5000"
      ]
    },
    {
      "name": "Smart Campus Android Emulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Smart Campus Physical Phone",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define",
        "API_BASE_URL=http://192.168.1.17:8000"
      ]
    }
  ]
}
